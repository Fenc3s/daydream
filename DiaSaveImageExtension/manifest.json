{
  "manifest_version": 3,
  "name": "Daydream Save Image to Photos",
  "version": "1.1.0",
  "description": "Adds a browser image context-menu command that saves the selected image to Photos through Daydream.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
